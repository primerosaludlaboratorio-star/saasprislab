# =============================================================================
# PRISLAB SaaS — Variables de entorno para backup/restore
# =============================================================================
# Copia este archivo como .env en la raíz del proyecto y ajusta los valores.
# NO commitear credenciales reales.
# =============================================================================

# ── Conexión PostgreSQL ──────────────────────────────────────────────────────
DB_NAME=prislab_v5
DB_USER=prislab_user
DB_PASSWORD=replace_with_secure_password
DB_HOST=db
DB_PORT=5432

# ── Configuración de backups ───────────────────────────────────────────────
BACKUP_DIR=/opt/prislab/backups
BACKUP_PREFIX=prislab
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION_LEVEL=6

# ── Replica a object storage S3-compatible (opcional) ──────────────────────
# Ejemplo: Vultr Object Storage, AWS S3, MinIO, etc.
S3_BACKUP_ENABLED=false
S3_BACKUP_BUCKET=prislab-backups
S3_BACKUP_ENDPOINT=https://ewr1.vultrobjects.com
S3_BACKUP_ACCESS_KEY=replace_with_access_key
S3_BACKUP_SECRET_KEY=replace_with_secret_key
S3_BACKUP_REGION=us-east-1
