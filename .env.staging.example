# ==============================================================================
# PRISLAB V5 — Variables de Entorno STAGING (VPS / Docker Compose)
# ==============================================================================
# Guardar como /opt/prislab/.env.staging en la VPS de staging
# Proteger: chmod 600 /opt/prislab/.env.staging
# NO commitear este archivo con valores reales.
# ==============================================================================

# --- Entorno ---
PRISLAB_ENV=staging
DEBUG=False

# --- Django ---
SECRET_KEY=GENERAR-CON-python-get_random_secret_key-min-50-chars
ALLOWED_HOSTS=staging.tu-dominio.com,IP_DE_STAGING
SERVER_NAME=staging.tu-dominio.com

# --- CSRF ---
CSRF_TRUSTED_ORIGINS=https://staging.tu-dominio.com

# --- URL pública ---
SITE_URL=https://staging.tu-dominio.com

# --- HTTPS hardening (desactivar si staging no tiene certificado válido) ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://staging.tu-dominio.com

# --- Base de Datos PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=prislab_staging
DB_USER=prislab_user
DB_PASSWORD=CLAVE-SEGURA-POSTGRESQL
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# --- Google Drive (opcional en staging) ---
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_TOKEN_PATH=/opt/prislab/credentials/token.json
GOOGLE_DRIVE_CREDENTIALS_PATH=/opt/prislab/credentials/credentials.json
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_FOLDER_ID=

# --- IA (usar claves de prueba en staging) ---
AI_PROVIDER=gemini
GOOGLE_API_KEY=tu-clave-gemini-de-staging
GEMINI_API_KEY=tu-clave-gemini-de-staging
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Tokens de servicio (generar tokens largos aleatorios) ---
PRISLAB_API_TOKEN=GENERAR-TOKEN-LARGO-ALEATORIO
PRISLAB_FRONTEND_LOG_TOKEN=GENERAR-TOKEN-LARGO-ALEATORIO
PRISLAB_KIOSCO_API_TOKEN=GENERAR-TOKEN-LARGO-ALEATORIO
PRISCI_WEBHOOK_TOKEN=GENERAR-TOKEN-LARGO-ALEATORIO
PRISCI_WEBHOOK_VERIFY_TOKEN=GENERAR-TOKEN-LARGO-ALEATORIO
CRON_SECRET=GENERAR-TOKEN-LARGO-ALEATORIO

# --- Seguridad clínica ---
FERNET_KEY=GENERAR-CON-Fernet.generate_key().decode()
LAB_VALIDATION_PIN=MINIMO-8-CHARS-ALFANUMERICO
PRISLAB_ESCUDO_USUARIO_ID=1

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PRISLAB Staging <noreply@staging.tu-dominio.com>
DIRECTOR_EMAIL=director@tu-empresa.com

# --- Redis ---
REDIS_PASSWORD=CLAVE-REDIS-STAGING
REDIS_URL=redis://:CLAVE-REDIS-STAGING@redis:6379/0

# --- VAPID (Web Push notifications) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# --- Facturación SAT (CFDI 4.0) ---
FACTURAMA_USER=
FACTURAMA_PASSWORD=
FACTURAMA_SANDBOX=True

# --- HL7 / middleware local ---
HL7_ACTIVE=False
HL7_API_KEY=
HL7_ALLOWED_IPS=127.0.0.1
HL7_IP_EMPRESA_MAP={"127.0.0.1":1}

# --- PRIS Sentinel / GitHub ---
GITHUB_TOKEN=
GITHUB_REPO=primerosaludlaboratorio-star/saasprislab

# --- Backup / DR ---
BACKUP_DIR=/opt/prislab/backups
BACKUP_RETENTION_DAYS=7
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
